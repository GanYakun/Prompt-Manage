{
  "name": "prompt-version-manager",
  "version": "1.0.0",
  "description": "Electron desktop application for managing and versioning prompts with Vue3",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:vue\" \"wait-on http://localhost:5175 && electron . --dev\"",
    "dev:vue": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "electron:dev": "electron . --dev",
    "electron:pack": "electron-builder"
  },
  "keywords": [
    "electron",
    "prompt",
    "version-control",
    "vue3"
  ],
  "author": "Prompt Manager",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0",
    "fast-check": "^3.15.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "@vitejs/plugin-vue": "^4.5.2"
  },
  "dependencies": {
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0",
    "vue": "^3.4.0",
    "pinia": "^2.1.7",
    "vue-router": "^4.2.5"
  },
  "build": {
    "appId": "com.promptmanager.app",
    "productName": "我的灵感笔记本",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ]
  }
}
